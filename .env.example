# SignalForge environment (اختياري بالكامل — التشغيل المحلي لا يحتاج أي مفاتيح)
# تخزين دائم مجاني: ضع رابط PostgreSQL من Supabase Free هنا.
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[HOST]:5432/postgres?sslmode=require
# SUPABASE_DB_URL هو اسم بديل مقبول إذا فضّلت استخدامه.
# التحقق الصارم من شهادة PostgreSQL يُفعَّل تلقائياً عند توفير سلسلة CA (PGSSL_CA أو PGSSL_CA_FILE).
# PGSSL_STRICT=1 يفرضه يدوياً حتى بدون CA، وPGSSL_STRICT=0 يعطّله دائماً (الوضع المتوافق القديم).
# PGSSL_CA_FILE=/path/to/prod-ca-2021.crt
# أو الصق الشهادة مباشرة (الأسطر الجديدة تُكتب \n):
# PGSSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# لو حابب تحدد توكن الأدمن يدوياً بدل الوضع المحلي المفتوح:
# BOT_ADMIN_TOKEN=my-secret-token
# المفكرة الاقتصادية: real (افتراضي) يسحب مفكرة حقيقية أسبوعية من مصدر خارجي مجاني
# مع رجوع تلقائي للجدول الاسترشادي عند أي فشل. reference يفرض الجدول الاسترشادي دائماً.
# MACRO_CALENDAR_MODE=real
# لو حابب تثبت تليجرام من غير لوحة الإعدادات:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Dune read-only on-chain research context (optional; never committed with a value).
# DUNE_API_KEY=
# Whale Alert on-chain netflow factor (optional; the factor degrades to null without a key).
# WHALE_ALERT_API_KEY=
